{
  "name": "enterprise-agile-site",
  "type": "module",
  "version": "0.4.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "npm run build && node scripts/validate-build.mjs",
    "preview": "astro preview",
    "deploy:dev": "npm run build && wrangler deploy --env dev",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
