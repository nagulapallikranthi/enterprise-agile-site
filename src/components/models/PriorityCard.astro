---
interface Props {
  title: string;
  description: string;
  health: "On track" | "Watch";
  progress: number;
}

const { title, description, health, progress } = Astro.props;
const tone = health === "On track" ? "good" : "watch";
---

<article class="priority-card model-panel">
  <div class="priority-heading">
    <h3>{title}</h3>
    <span class={`health health--${tone}`}>{health}</span>
  </div>
  <p>{description}</p>
  <div class="progress-meta"><span>Delivery confidence</span><strong>{progress}%</strong></div>
  <div class="progress-track" role="progressbar" aria-label={`${title} delivery confidence`} aria-valuemin="0" aria-valuemax="100" aria-valuenow={progress}>
    <span style={`width: ${progress}%`}></span>
  </div>
</article>

<style>
  .priority-card { padding: 24px; box-shadow: none; }
  .priority-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  h3 { font-size: 1.05rem; }
  p { margin-top: 10px; color: var(--model-text-muted); font-size: .93rem; }
  .health { flex: none; padding: 6px 10px; border-radius: 999px; font-size: .7rem; font-weight: 800; }
  .health--good { color: var(--model-green); background: var(--model-green-soft); }
  .health--watch { color: var(--model-amber); background: var(--model-amber-soft); }
  .progress-meta { display: flex; justify-content: space-between; margin-top: 22px; color: var(--model-text-muted); font-size: .76rem; }
  .progress-meta strong { color: var(--model-text); }
  .progress-track { height: 8px; margin-top: 8px; overflow: hidden; border-radius: 99px; background: var(--model-surface-muted); }
  .progress-track span { display: block; height: 100%; border-radius: inherit; background: var(--model-blue); }
</style>
