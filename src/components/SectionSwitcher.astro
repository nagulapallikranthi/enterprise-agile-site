---
interface Item { id: string; label: string; }
interface Props { items: Item[]; label: string; class?: string; }

const { items, label, class: className = "" } = Astro.props;
---

<section class:list={["site-switcher", className]} data-section-switcher>
  <nav class="site-switcher-nav" aria-label={label} role="tablist">
    {items.map((item, index) => (
      <button type="button" role="tab" id={`switch-${item.id}`} aria-controls={`panel-${item.id}`}
        aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? "0" : "-1"}
        data-section-target={item.id}>
        {item.label}
      </button>
    ))}
  </nav>
  <div class="site-switcher-canvas"><slot /></div>
</section>

<script>
  document.querySelectorAll('[data-section-switcher]').forEach((switcher) => {
    const buttons = Array.from(switcher.querySelectorAll('[data-section-target]'));
    const panels = Array.from(switcher.querySelectorAll(':scope > .site-switcher-canvas > [data-section-panel]'));
    const activate = (value, moveFocus = false, moveViewport = false) => {
      buttons.forEach((button) => {
        const active = button.dataset.sectionTarget === value;
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
        if (active) {
          button.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          if (moveFocus) button.focus();
        }
      });
      panels.forEach((panel) => {
        const active = panel.dataset.sectionPanel === value;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
        if (active && moveViewport) {
          requestAnimationFrame(() => panel.scrollIntoView({ behavior: 'smooth', block: 'start' }));
        }
      });
    };
    buttons.forEach((button) => button.addEventListener('click', () => activate(button.dataset.sectionTarget, false, true)));
    switcher.querySelector('.site-switcher-nav')?.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const current = buttons.indexOf(document.activeElement);
      const delta = ['ArrowRight', 'ArrowDown'].includes(event.key) ? 1 : -1;
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : (current + delta + buttons.length) % buttons.length;
      activate(buttons[next].dataset.sectionTarget, true, true);
    });
    panels.forEach((panel, index) => {
      panel.id = `panel-${panel.dataset.sectionPanel}`;
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', `switch-${panel.dataset.sectionPanel}`);
      panel.hidden = index !== 0;
      panel.classList.toggle('is-active', index === 0);
    });
    const activateHashTarget = () => {
      if (!window.location.hash) return;
      const target = document.querySelector(window.location.hash);
      const panel = target?.closest('[data-section-panel]');
      if (panel && switcher.contains(panel)) activate(panel.dataset.sectionPanel);
    };
    window.addEventListener('hashchange', activateHashTarget);
    activateHashTarget();
  });
</script>

<style>
  .site-switcher{display:grid;grid-template-columns:220px minmax(0,1fr);gap:22px;width:min(calc(100% - 40px),1240px);margin:0 auto;padding-block:34px 70px}
  .site-switcher-nav{position:sticky;top:92px;display:grid;align-self:start;gap:6px;height:max-content;padding:8px;border:1px solid rgba(148,163,184,.18);border-radius:14px;background:rgba(10,23,40,.94);box-shadow:0 18px 50px rgba(0,0,0,.16);backdrop-filter:blur(14px)}
  .site-switcher-nav button{display:block;width:100%;padding:12px;border:0;border-radius:9px;color:#aebbd0;background:transparent;text-align:left;font:inherit;font-size:.78rem;font-weight:800;cursor:pointer}
  .site-switcher-nav button:hover,.site-switcher-nav button:focus-visible{color:#fff;background:rgba(96,165,250,.11)}
  .site-switcher-nav button[aria-selected="true"]{color:#fff;background:#23496f}
  .site-switcher-canvas{min-width:0}.site-switcher-canvas>[data-section-panel][hidden]{display:none!important}
  @media(max-width:900px){.site-switcher{grid-template-columns:1fr;width:100%;padding-top:0}.site-switcher-nav{top:80px;z-index:18;display:flex;overflow-x:auto;width:100%;padding:8px max(14px,calc((100% - 760px)/2));border-width:1px 0;border-radius:0;background:#0a1728;scrollbar-width:none}.site-switcher-nav::-webkit-scrollbar{display:none}.site-switcher-nav::after{content:"";position:sticky;right:0;flex:0 0 26px;background:linear-gradient(90deg,transparent,#0a1728);pointer-events:none}.site-switcher-nav button{flex:0 0 auto;width:auto;white-space:nowrap}.site-switcher-canvas{width:min(calc(100% - 28px),760px);margin-inline:auto}}
</style>
