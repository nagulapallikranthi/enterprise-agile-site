---
// Destination: src/components/Carousel.astro
// Reusable carousel component — replaces the duplicated impact + framework carousel logic.
//
// Usage in index.astro:
//
//   import Carousel from "../components/Carousel.astro";
//
//   <!-- Impact carousel -->
//   <Carousel
//     id="impact"
//     label="Delivery impact carousel"
//     positionLabel="outcomes"
//     cssOffsetVar="--impact-offset"
//   >
//     <!-- impact-card articles go here as <slot> children -->
//   </Carousel>
//
//   <!-- Framework carousel -->
//   <Carousel
//     id="framework"
//     label="Governance frameworks carousel"
//     positionLabel="frameworks"
//     cssOffsetVar="--framework-offset"
//     prevClass="carousel-prev"
//     nextClass="carousel-next"
//     cardSelector=".framework-card"
//   >
//     <!-- framework-card articles go here as <slot> children -->
//   </Carousel>

interface Props {
  id: string;                  // Unique identifier — used for data attributes + ARIA
  label: string;               // aria-label for the carousel region
  positionLabel: string;       // Suffix for position counter: "1–3 of 6 {positionLabel}"
  cssOffsetVar: string;        // CSS custom property name: e.g. "--impact-offset"
  cardSelector?: string;       // Selector for card children (default: ".carousel-card")
  prevClass?: string;          // Extra class on prev button (e.g. "carousel-prev")
  nextClass?: string;          // Extra class on next button (e.g. "carousel-next")
  total: number;               // Total number of items — passed explicitly for SSR label
}

const {
  id,
  label,
  positionLabel,
  cssOffsetVar,
  cardSelector  = ".carousel-card",
  prevClass     = "",
  nextClass     = "",
  total,
} = Astro.props;

const prevId = `${id}-prev`;
const nextId = `${id}-next`;
const trackId = `${id}-track`;
const posId  = `${id}-position`;
---

<div
  class="carousel-root"
  data-carousel
  data-carousel-id={id}
  data-css-var={cssOffsetVar}
  data-card-selector={cardSelector}
  aria-label={label}
>
  <div class="carousel-controls">
    <p>
      <span id={posId} data-position>1–3</span> of {total} {positionLabel}
    </p>
    <div>
      <button
        id={prevId}
        type="button"
        class={`carousel-arrow-btn ${prevClass}`}
        data-prev
        aria-label={`Show previous ${positionLabel}`}
        disabled
      >←</button>
      <button
        id={nextId}
        type="button"
        class={`carousel-arrow-btn ${nextClass}`}
        data-next
        aria-label={`Show next ${positionLabel}`}
      >→</button>
    </div>
  </div>

  <div class="carousel-viewport">
    <div
      id={trackId}
      class="carousel-track"
      data-track
      aria-live="polite"
      style={`${cssOffsetVar}: 0px`}
    >
      <slot />
    </div>
  </div>
</div>

<style>
  .carousel-root { width: 100%; }
  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .carousel-controls p { color: #94a3b8; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
  .carousel-controls > div { display: flex; gap: 10px; }
  .carousel-viewport { overflow: hidden; }
  .carousel-track {
    display: flex;
    width: 100%;
    gap: 16px;
    /* Transform is driven by the CSS custom property passed via data-css-var */
    transition: transform .42s cubic-bezier(.22, .8, .28, 1);
  }
  .carousel-arrow-btn {
    width: 44px; height: 44px;
    border: 1px solid rgba(96, 165, 250, .38);
    border-radius: 50%;
    color: #f8fafc;
    background: rgba(30, 64, 175, .18);
    font-size: 22px;
    cursor: pointer;
    transition: border-color .2s, background .2s, transform .2s, opacity .2s;
  }
  .carousel-arrow-btn:hover:not(:disabled),
  .carousel-arrow-btn:focus-visible {
    border-color: #60a5fa;
    background: rgba(37, 99, 235, .34);
    transform: translateY(-2px);
  }
  .carousel-arrow-btn:disabled { opacity: .28; cursor: default; }
</style>

<script>
  // Single carousel controller — handles all [data-carousel] instances on the page.
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const cssVar      = root.dataset.cssVar ?? "--carousel-offset";
    const cardSel     = root.dataset.cardSelector ?? ".carousel-card";
    const track       = root.querySelector<HTMLElement>("[data-track]");
    const cards       = Array.from(root.querySelectorAll<HTMLElement>(cardSel));
    const prevBtn     = root.querySelector<HTMLButtonElement>("[data-prev]");
    const nextBtn     = root.querySelector<HTMLButtonElement>("[data-next]");
    const posEl       = root.querySelector<HTMLElement>("[data-position]");

    if (!track || cards.length === 0) return;

    const visible = () =>
      window.innerWidth <= 620 ? 1 : window.innerWidth <= 980 ? 2 : 3;

    let start = 0;

    const render = () => {
      const v   = visible();
      const max = Math.max(0, cards.length - v);
      start = Math.min(start, max);

      const cardWidth = cards[0]!.getBoundingClientRect().width;
      const gap       = Number.parseFloat(getComputedStyle(track).columnGap || "0");
      track.style.setProperty(cssVar, `${start * (cardWidth + gap)}px`);
      track.style.transform = `translateX(calc(-1 * var(${cssVar})))`;

      if (posEl) {
        posEl.textContent =
          v === 1
            ? `${start + 1}`
            : `${start + 1}–${Math.min(start + v, cards.length)}`;
      }
      if (prevBtn) prevBtn.disabled = start === 0;
      if (nextBtn) nextBtn.disabled = start >= max;
    };

    prevBtn?.addEventListener("click", () => {
      start = Math.max(0, start - visible());
      render();
    });

    nextBtn?.addEventListener("click", () => {
      start = Math.min(cards.length - visible(), start + visible());
      render();
    });

    window.addEventListener("resize", render, { passive: true });
    render();
  });
</script>
