---
import BrandMark from "./BrandMark.astro";
---

<nav class="site-nav" aria-label="Primary navigation">
  <a class="logo" href="/#top" aria-label="Enterprise Agile home">
    <BrandMark />
    <span class="logo-copy"><strong>Kranthi</strong><small>Enterprise Agile</small></span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-menu">
    <span class="sr-only">Open navigation menu</span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>

  <ul id="primary-menu">
    <li><a href="/#top">Home &amp; About</a></li>
    <li><a href="/#success-stories">Success Stories</a></li>
    <li><a href="/#frameworks">Frameworks</a></li>
    <li><a href="/#articles">Insights</a></li>
    <li><a href="/models/executive-portfolio/">Leadership Views</a></li>
    <li><a href="/#contact">Contact</a></li>
  </ul>
</nav>

<script>
  const nav = document.querySelector('.site-nav');
  const toggle = document.querySelector('.menu-toggle');
  const menu = document.querySelector('#primary-menu');
  const sectionLinks = Array.from(menu?.querySelectorAll('a[href^="/#"]') ?? []);

  const setActiveLink = (activeLink) => {
    menu?.querySelectorAll('a').forEach((link) => {
      const isActive = link === activeLink;
      link.classList.toggle('active', isActive);

      if (isActive) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  const updateActiveSection = () => {
    const navHeight = nav?.getBoundingClientRect().height ?? 0;
    const marker = window.scrollY + navHeight + 24;
    let activeLink = sectionLinks[0];

    sectionLinks.forEach((link) => {
      const target = document.querySelector(new URL(link.href).hash);
      if (target && target.offsetTop <= marker) activeLink = link;
    });

    setActiveLink(activeLink);
  };

  const closeMenu = () => {
    nav?.classList.remove('menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('menu-open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    closeMenu();
    setActiveLink(link);
  }));
  document.addEventListener('keydown', (event) => event.key === 'Escape' && closeMenu());
  window.addEventListener('scroll', updateActiveSection, { passive: true });
  window.addEventListener('hashchange', updateActiveSection);
  if (window.location.pathname.startsWith('/models/')) {
    const leadershipLink = menu?.querySelector('a[href="/models/executive-portfolio/"]');
    if (leadershipLink) setActiveLink(leadershipLink);
  } else {
    updateActiveSection();
  }
</script>
