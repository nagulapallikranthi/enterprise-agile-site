---
import "../styles/global.css";
import FamilyLaunch from "../components/FamilyLaunch.astro";
import packageMetadata from "../../package.json";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title = "Enterprise Agile | Enterprise Program Leadership",
  description = "Senior program leadership across enterprise transformation, delivery governance, operational excellence, executive reporting and responsible AI adoption.",
  canonicalPath = "/",
  noindex = false
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://enterprise-agile-site.nagulapalli-kranthi.workers.dev";
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImageUrl = new URL("/images/hero-portrait.png", siteUrl);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: "Kranthi Kumar Nagulapally — Enterprise Program & Operations Leader",
    url: canonicalUrl.toString(),
    mainEntity: {
      "@type": "Person",
      name: "Kranthi Kumar Nagulapally",
      jobTitle: "Senior Program Leader",
      url: siteUrl,
      sameAs: ["https://www.linkedin.com/in/kranthi-n"],
      knowsAbout: ["Enterprise Program Management", "CloudOps", "DevOps", "Agile Delivery Governance", "Jira and JSM Governance", "Executive Reporting", "Responsible AI"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Enterprise Agile",
    url: siteUrl
  }
];
---

<!DOCTYPE html>
<html lang="en" data-release={packageMetadata.version}>
<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071a33" />
    <meta name="application-version" content={packageMetadata.version} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=compass-k-1" sizes="any" />
    <link rel="shortcut icon" href="/favicon.svg?v=2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:site_name" content="Enterprise Agile" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

</head>

<body>
    <FamilyLaunch />
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />

    <script is:inline>
      const sessionKey = "portfolio-session-id";
      let sessionId = sessionStorage.getItem(sessionKey);
      if (!sessionId) {
        sessionId = crypto.randomUUID();
        sessionStorage.setItem(sessionKey, sessionId);
      }

      document.addEventListener("click", (event) => {
        const link = event.target.closest("a, button");
        if (!link) return;

        const action = link.dataset.trackAction ||
          (link.tagName === "A" ? "link_click" : "button_click");
        const label = (link.textContent || link.getAttribute("aria-label") || "unlabelled").trim();
        const payload = JSON.stringify({
          action,
          label,
          page: location.pathname,
          target: link.getAttribute("href") || null,
          referrer: document.referrer || null,
          sessionId,
          occurredAt: new Date().toISOString()
        });

        navigator.sendBeacon("/api/events", new Blob([payload], { type: "application/json" }));
      });
    </script>

</body>

</html>
