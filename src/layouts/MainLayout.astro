---
// Destination: src/layouts/MainLayout.astro
// Changes vs original:
//   1. Tracking script: sessionId removed — each event is anonymous and unlinked
//   2. Footer: privacy notice + links to /privacy and /terms added
//   3. noindex prop honoured consistently
import "../styles/global.css";
import packageMetadata from "../../package.json";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title = "Enterprise Agile | Enterprise Program Leadership",
  description = "Senior program leadership across enterprise transformation, delivery governance, operational excellence, executive reporting and responsible AI adoption.",
  canonicalPath = "/",
  noindex = false,
} = Astro.props;

// TODO: set PUBLIC_SITE_URL in Cloudflare Worker env vars and GitHub Actions
// per environment (DEV / STG / PROD). Replace the fallback once domain is registered.
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://enterprise-agile-site.nagulapalli-kranthi.workers.dev";
const canonicalUrl  = new URL(canonicalPath, siteUrl);
const socialImageUrl = new URL("/images/hero-portrait.png", siteUrl);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: "Kranthi Kumar Nagulapally — Enterprise Program & Operations Leader",
    url: canonicalUrl.toString(),
    mainEntity: {
      "@type": "Person",
      name: "Kranthi Kumar Nagulapally",
      jobTitle: "Senior Program Leader",
      url: siteUrl,
      sameAs: ["https://www.linkedin.com/in/kranthi-n"],
      knowsAbout: [
        "Enterprise Program Management",
        "CloudOps",
        "DevOps",
        "Agile Delivery Governance",
        "Jira and JSM Governance",
        "Executive Reporting",
        "Responsible AI",
      ],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Enterprise Agile",
    url: siteUrl,
  },
];
---

<!DOCTYPE html>
<html lang="en" data-release={packageMetadata.version}>
<head>
  <meta charset="UTF-8" />
  <meta name="google-site-verification" content="kpcQqDmqbgAMD0HL8ZKhcAa-xTngtRPswsXYAo2zo6Y" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#071a33" />
  <meta name="application-version" content={packageMetadata.version} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=compass-k-1" sizes="any" />
  <link rel="shortcut icon" href="/favicon.svg?v=2" />
  <meta property="og:type"        content="website" />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:image"       content={socialImageUrl} />
  <meta property="og:site_name"   content="Enterprise Agile" />
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={socialImageUrl} />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
</head>

<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <slot />

  <!--
    Analytics: anonymous click events only.
    No cookies. No session IDs. No persistent identifiers.
    Each event is independent and cannot be linked to an individual.
    See /privacy for full details.
  -->
  <script is:inline>
    document.addEventListener("click", (event) => {
      const link = event.target.closest("a, button");
      if (!link) return;

      const action = link.dataset.trackAction ||
        (link.tagName === "A" ? "link_click" : "button_click");
      const label = (link.textContent || link.getAttribute("aria-label") || "unlabelled").trim();

      // Each event gets a fresh random ID — NOT linked across events or sessions.
      const payload = JSON.stringify({
        action,
        label,
        page:       location.pathname,
        target:     link.getAttribute("href") || null,
        occurredAt: new Date().toISOString(),
        // sessionId intentionally removed — see privacy policy
      });

      navigator.sendBeacon("/api/events", new Blob([payload], { type: "application/json" }));
    });
  </script>
</body>
</html>

