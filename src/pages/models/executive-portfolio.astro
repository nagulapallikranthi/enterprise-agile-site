---
import MainLayout from "../../layouts/MainLayout.astro";
import MetricCard from "../../components/models/MetricCard.astro";
import PriorityCard from "../../components/models/PriorityCard.astro";
import SectionSwitcher from "../../components/SectionSwitcher.astro";
import Header from "../../components/Header.astro";
import { portfolio } from "../../data/portfolio";
import "../../styles/model-system.css";
---

<MainLayout
  title="Executive Portfolio | Enterprise Agile"
  description="An executive portfolio view of enterprise delivery priorities, health and measurable outcomes."
  canonicalPath="/models/executive-portfolio/"
>
  <div class="model-page" id="overview">
    <Header />

    <main id="main-content">
      <section class="executive-hero model-container" aria-labelledby="executive-title">
        <div>
          <span class="model-kicker">Leadership View 1 · Executive Portfolio</span>
          <h1 id="executive-title">Turn complex delivery into <em>decision clarity.</em></h1>
          <p>{portfolio.identity.positioning}. A concise owner view of priorities, confidence and outcomes.</p>
          <div class="hero-actions">
            <a class="executive-primary" href="#priorities">Review portfolio health</a>
            <a class="executive-secondary" href="/downloads/Kranthi_Delivery_Leader.pdf" download="Kranthi_Delivery_Leader.pdf" data-track-action="resume_download">Download profile</a>
          </div>
        </div>
        <aside class="owner-card model-panel" aria-label="Portfolio owner">
          <span>Portfolio owner</span>
          <strong>{portfolio.identity.name}</strong>
          <p>{portfolio.identity.role}</p>
          <dl>
            <div><dt>Review cycle</dt><dd>Weekly</dd></div>
            <div><dt>Current health</dt><dd><i></i> On track</dd></div>
            <div><dt>Release</dt><dd>0.3.0</dd></div>
          </dl>
        </aside>
      </section>

      <SectionSwitcher label="Executive portfolio sections" items={[
        { id: "portfolio-health", label: "Portfolio health" },
        { id: "portfolio-priorities", label: "Priorities" },
        { id: "portfolio-outcomes", label: "Outcomes" },
        { id: "portfolio-contact", label: "Next decision" }
      ]}>
      <section class="metric-section" aria-label="Portfolio metrics" data-section-panel="portfolio-health">
        {portfolio.metrics.map((metric) => <MetricCard {...metric} />)}
      </section>

      <section class="portfolio-section" id="priorities" aria-labelledby="priorities-title" data-section-panel="portfolio-priorities">
        <div class="section-heading-row">
          <div>
            <span class="model-kicker">Current priorities</span>
            <h2 class="model-section-title" id="priorities-title">Where leadership attention creates leverage</h2>
          </div>
          <p>Live portfolio signals designed to make progress, confidence and intervention needs clear at a glance.</p>
        </div>
        <div class="priority-grid">
          {portfolio.priorities.map((priority) => <PriorityCard {...priority} />)}
        </div>
      </section>

      <section class="outcomes" id="outcomes" aria-labelledby="outcomes-title" data-section-panel="portfolio-outcomes" data-outcome-workspace>
        <div class="outcome-nav-wrap">
          <span class="model-kicker">Evidence of execution</span>
          <h2 class="model-section-title" id="outcomes-title">Governance built around outcomes</h2>
          <div class="outcome-nav" role="tablist" aria-label="Governance outcomes">
            {portfolio.outcomeDetails.map((outcome, index) => (
              <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`outcome-panel-${index}`} data-outcome-target={index}>
                <span>0{index + 1}</span><strong>{outcome.label}</strong>
              </button>
            ))}
          </div>
        </div>
        <div class="outcome-progressive progressive-panel" aria-live="polite">
          {portfolio.outcomeDetails.map((outcome, index) => (
            <article id={`outcome-panel-${index}`} role="tabpanel" data-outcome-panel={index} hidden={index !== 0}>
              <span class="outcome-number">Outcome 0{index + 1}</span>
              <h3>{outcome.title}</h3>
              <p>{outcome.summary}</p>
              <details>
                <summary>View execution evidence</summary>
                <div>
                  <p>{outcome.evidence}</p>
                  <strong>{outcome.result}</strong>
                </div>
              </details>
            </article>
          ))}
        </div>
      </section>

      <section class="executive-contact" id="contact" aria-labelledby="contact-title" data-section-panel="portfolio-contact">
        <div class="contact-inner">
          <div><span class="model-kicker">Next decision</span><h2 id="contact-title">Build the operating system your portfolio needs.</h2></div>
          <a href="mailto:nagulapalli.kranthi@gmail.com?subject=Executive%20Portfolio%20Conversation">Start a conversation <span aria-hidden="true">→</span></a>
        </div>
      </section>
      </SectionSwitcher>
    </main>
  </div>
</MainLayout>

<style>
  .model-page {
    --model-bg: #0f1a2e;
    --model-surface: #17243a;
    --model-surface-muted: #22314a;
    --model-text: #f4f7fb;
    --model-text-muted: #aebbd0;
    --model-border: #2d3c55;
    --model-blue: #60a5fa;
    --model-blue-soft: #19385f;
    --model-green: #4fd1a5;
    --model-green-soft: #173c38;
    --model-amber: #f2c46d;
    --model-amber-soft: #45381f;
    --model-violet: #a78bfa;
    --model-violet-soft: #302858;
    --model-shadow: 0 18px 48px rgba(2, 8, 23, .24);
    background: linear-gradient(180deg, #111c31 0%, #0b1526 100%);
  }
  .executive-hero { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(300px, .55fr); gap: 72px; align-items: center; padding-block: 94px 72px; }
  h1 { max-width: 780px; margin-top: 18px; font-size: clamp(3rem, 6.5vw, 5.8rem); line-height: .98; letter-spacing: -.065em; }
  h1 em { color: var(--model-blue); font-style: normal; }
  .executive-hero > div > p { max-width: 680px; margin-top: 28px; color: var(--model-text-muted); font-size: 1.08rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .hero-actions a { padding: 14px 19px; border-radius: var(--model-radius-sm); font-size: .83rem; font-weight: 800; }
  .executive-primary { background: var(--model-blue); color: white !important; }
  .executive-secondary { border: 1px solid var(--model-border); background: var(--model-surface); }
  .owner-card { padding: 28px; }
  .owner-card > span { color: var(--model-text-muted); font-size: .72rem; font-weight: 750; text-transform: uppercase; letter-spacing: .1em; }
  .owner-card > strong { display: block; margin-top: 18px; font-size: 1.2rem; }
  .owner-card > p { color: var(--model-text-muted); }
  dl { margin-top: 24px; border-top: 1px solid var(--model-border); }
  dl div { display: flex; justify-content: space-between; gap: 12px; padding-block: 13px; border-bottom: 1px solid var(--model-border); font-size: .78rem; }
  dt { color: var(--model-text-muted); } dd { font-weight: 750; } dd i { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--model-green); }
  .metric-section { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .portfolio-section { padding-block: 110px; }
  .section-heading-row { display: flex; justify-content: space-between; align-items: end; gap: 48px; }
  .section-heading-row > p { max-width: 430px; color: var(--model-text-muted); font-size: .92rem; }
  .priority-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 38px; }
  .outcomes { display: grid; grid-template-columns: minmax(280px,.8fr) minmax(0,1.2fr); gap: 28px; align-items: start; padding-bottom: 110px; }
  .outcome-nav-wrap, .outcome-progressive { min-height: 360px; border: 1px solid var(--model-border); border-radius: 18px; background: rgba(23,36,58,.72); }
  .outcome-nav-wrap { position: sticky; top: 104px; padding: 28px; }
  .outcome-nav-wrap h2 { margin: 8px 0 24px; font-size: clamp(1.7rem,3vw,2.5rem); }
  .outcome-nav { display: grid; gap: 7px; }
  .outcome-nav button { display: grid; grid-template-columns: 34px 1fr; gap: 10px; align-items: center; width: 100%; padding: 13px 14px; border: 0; border-radius: 10px; color: var(--model-text-muted); background: transparent; text-align: left; cursor: pointer; }
  .outcome-nav button span { color: #6f8db3; font-size: .66rem; font-weight: 850; }
  .outcome-nav button strong { font-size: .82rem; }
  .outcome-nav button:hover, .outcome-nav button:focus-visible { color: white; background: rgba(96,165,250,.1); }
  .outcome-nav button[aria-selected="true"] { color: white; background: #23496f; }
  .outcome-nav button[aria-selected="true"] span { color: #93c5fd; }
  .outcome-progressive { padding: 32px; }
  .outcome-progressive article[hidden] { display: none; }
  .outcome-number { color: var(--model-blue); font-size: .7rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  .outcome-progressive h3 { max-width: 620px; margin: 12px 0 14px; font-size: clamp(1.45rem,2.8vw,2.25rem); line-height: 1.12; }
  .outcome-progressive article > p { max-width: 680px; color: var(--model-text-muted); }
  .outcome-progressive details { margin-top: 28px; border-top: 1px solid var(--model-border); border-bottom: 1px solid var(--model-border); }
  .outcome-progressive summary { display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; color: white; font-size: .82rem; font-weight: 800; cursor: pointer; list-style: none; }
  .outcome-progressive summary::-webkit-details-marker { display: none; }
  .outcome-progressive summary::after { content: "+"; color: var(--model-blue); font-size: 1.25rem; line-height: .8; }
  .outcome-progressive details[open] summary::after { content: "−"; }
  .outcome-progressive details div { padding: 0 0 22px; color: var(--model-text-muted); }
  .outcome-progressive details div strong { display: block; margin-top: 14px; color: var(--model-green); }
  .executive-contact { border-top: 1px solid var(--model-border); background: #081221; color: white; }
  .contact-inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding-block: 62px; }
  .contact-inner h2 { max-width: 700px; margin-top: 8px; font-size: clamp(1.8rem, 4vw, 3.3rem); line-height: 1.06; letter-spacing: -.04em; }
  .contact-inner a { flex: none; padding: 15px 18px; border-radius: var(--model-radius-sm); background: var(--model-blue); color: #071426; font-size: .84rem; font-weight: 850; }
  @media (max-width: 900px) {
    nav { display: none; }
    .executive-hero { grid-template-columns: 1fr; gap: 36px; padding-block: 70px 54px; }
    .metric-section { grid-template-columns: repeat(2, 1fr); }
    .priority-grid { grid-template-columns: 1fr; }
    .section-heading-row, .contact-inner { align-items: flex-start; }
    .outcomes { grid-template-columns: 1fr; gap: 14px; }
    .outcome-nav-wrap { position: static; min-height: 0; }
    .outcome-progressive { min-height: 330px; }
  }
  @media (max-width: 600px) {
    .executive-hero { padding-top: 54px; }
    h1 { font-size: 3.25rem; }
    .metric-section { grid-template-columns: 1fr; }
    .section-heading-row, .contact-inner { display: grid; }
    .portfolio-section { padding-block: 82px; }
    .outcomes { padding-bottom: 82px; }
  }
</style>

<script>
  document.querySelectorAll('[data-outcome-workspace]').forEach((workspace) => {
    const tabs = Array.from(workspace.querySelectorAll('[data-outcome-target]'));
    const panels = Array.from(workspace.querySelectorAll('[data-outcome-panel]'));
    const activate = (index, focus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.outcomeTarget === String(index);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => {
        const active = panel.dataset.outcomePanel === String(index);
        panel.hidden = !active;
        if (active) panel.querySelector('details')?.removeAttribute('open');
      });
    };
    tabs.forEach((tab, index) => {
      tab.tabIndex = index === 0 ? 0 : -1;
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowUp', 'ArrowDown', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length;
        activate(next, true);
      });
    });
  });
</script>
