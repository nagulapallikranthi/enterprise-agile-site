---
import MainLayout from "../../layouts/MainLayout.astro";
import SignalContent from "../../components/models/SignalContent.astro";
import Header from "../../components/Header.astro";
import "../../styles/model-system.css";

const sections = [
  {
    id: "health",
    label: "Service health",
    headline: "Core services remain stable",
    summary: "Availability is within the operating target; one degradation is contained and under active review.",
    metrics: [["Availability", "99.94%", "Healthy"], ["Open incidents", "7", "Stable"], ["Change success", "96%", "Healthy"]],
    action: "Continue normal monitoring; review the contained degradation at the next operating checkpoint."
  },
  {
    id: "sla",
    label: "SLA risk",
    headline: "Three items need intervention",
    summary: "Aggregate SLA remains green, but two high-priority items and one ageing request could breach before the next review.",
    metrics: [["SLA attained", "93%", "Healthy"], ["At risk", "3", "Watch"], ["Breached", "1", "Act"]],
    action: "Service owners validate priority, pause conditions and recovery plans before the next checkpoint."
  },
  {
    id: "ageing",
    label: "Ageing",
    headline: "The oldest queue needs ownership",
    summary: "Most work is moving normally. Four unresolved items exceed the ageing threshold and two lack a current next action.",
    metrics: [["Oldest item", "18d", "Watch"], ["Over threshold", "4", "Watch"], ["No next action", "2", "Act"]],
    action: "Confirm accountable owners, resolution dates and closure evidence for the four ageing items."
  },
  {
    id: "ownership",
    label: "Ownership",
    headline: "Workload concentration is emerging",
    summary: "Critical work is assigned, but 42% of active priority work sits with two owners, creating continuity risk.",
    metrics: [["Unassigned", "2", "Act"], ["Top-2 concentration", "42%", "Watch"], ["Coverage", "91%", "Healthy"]],
    action: "Rebalance priority work and nominate secondary owners for continuity-sensitive services."
  },
  {
    id: "patterns",
    label: "Patterns & cost",
    headline: "A repeat failure is a prevention candidate",
    summary: "A recurring access issue accounts for five recent requests. Standardization could remove avoidable handling effort.",
    metrics: [["Repeat pattern", "5", "Watch"], ["Automation candidates", "3", "Healthy"], ["Avoidable effort", "14h", "Watch"]],
    action: "Validate the root cause, quantify the recurring effort and prioritize the best prevention candidate."
  }
];
---

<MainLayout
  title="CloudOps Command Center | Enterprise Agile"
  description="A concise CloudOps command center using responsive sticky section navigation and synthetic operational data."
  canonicalPath="/models/cloudops-command-center/"
>
  <div class="command-page">
    <Header />

    <main id="main-content" class="model-container">
      <section class="intro">
        <div>
          <span class="model-kicker">Leadership View · CloudOps Command Center</span>
          <h1>Operational depth without the <em>scroll fatigue.</em></h1>
          <p>Review operational health, risk and action in one concise workspace. Select a domain to replace the decision canvas without adding page length.</p>
        </div>
        <aside class="decision-card">
          <span>Interaction standard</span>
          <strong>Fast orientation. Clear action. Minimal movement.</strong>
          <p>The selector stays visible on laptops and becomes a horizontal sticky control on mobile.</p>
        </aside>
      </section>

      <section class="workspace" aria-live="polite">
        <div class="pattern-panel is-active">
          <header class="panel-heading"><div><span>Enterprise view</span><h2>Operational decision workspace</h2></div><p>A persistent local navigator maintains orientation while replacing the decision canvas.</p></header>
          <div class="switcher-shell">
            <nav class="section-switcher" aria-label="CloudOps sections">
              {sections.map((section, index) => <button type="button" class:list={{ active: index === 0 }} data-switch={section.id}>{section.label}</button>)}
            </nav>
            <div class="switcher-canvas">
              {sections.map((section, index) => <article class:list={["signal-view", { "is-active": index === 0 }]} data-switch-panel={section.id}><SignalContent section={section} /></article>)}
            </div>
          </div>
        </div>
      </section>

      <footer class="review-footer">
        <div><span class="sample-dot"></span><p><strong>Synthetic demonstration data.</strong> No organization, customer, incident or financial information is represented.</p></div>
        <a href="#main-content">Back to overview ↑</a>
      </footer>
    </main>
  </div>
</MainLayout>

<script>
  const activateSet = (buttons, panels, value, buttonAttribute, panelAttribute) => {
    buttons.forEach((button) => {
      const active = button.getAttribute(buttonAttribute) === value;
      button.classList.toggle('active', active);
      button.setAttribute('aria-selected', String(active));
      button.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => {
      const active = panel.getAttribute(panelAttribute) === value;
      panel.classList.toggle('is-active', active);
      panel.hidden = !active;
    });
  };

  const switchButtons = Array.from(document.querySelectorAll('[data-switch]'));
  const switchPanels = Array.from(document.querySelectorAll('[data-switch-panel]'));
  switchButtons.forEach((button) => button.addEventListener('click', () => {
    activateSet(switchButtons, switchPanels, button.dataset.switch, 'data-switch', 'data-switch-panel');
    button.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }));

  document.querySelectorAll('[role="tablist"]').forEach((tablist) => tablist.addEventListener('keydown', (event) => {
    if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
    const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
    const current = tabs.indexOf(document.activeElement);
    const next = event.key === 'ArrowRight' ? (current + 1) % tabs.length : (current - 1 + tabs.length) % tabs.length;
    event.preventDefault();
    tabs[next]?.focus();
    tabs[next]?.click();
  }));
</script>

<style is:global>
  .command-page{--ink:#f8fafc;--muted:#aab9cf;--panel:#17243a;--panel-2:#1d2c45;--line:#2b3d5a;--blue:#60a5fa;--green:#4fd1a5;--amber:#f2c46d;min-height:100vh;color:var(--ink);background:radial-gradient(circle at 78% 12%,rgba(37,99,235,.18),transparent 32%),linear-gradient(180deg,#111c31,#091322)}
  .topbar{border-bottom:1px solid var(--line);background:rgba(9,19,34,.9);backdrop-filter:blur(14px)}.topbar-inner{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:10px}.brand span{display:grid;width:36px;height:36px;place-items:center;border-radius:9px;background:#2563eb;font-size:.7rem;font-weight:900}.brand strong{font-size:.9rem}.review-badge{padding:6px 9px;border:1px solid #345077;border-radius:99px;color:#9cc8ff;font-size:.65rem;font-weight:850;text-transform:uppercase;letter-spacing:.1em}.model-link{color:var(--blue);font-size:.78rem;font-weight:800}
  .intro{display:grid;grid-template-columns:1.35fr .65fr;gap:56px;align-items:center;padding-block:62px 42px}.intro h1{max-width:800px;margin-top:12px;font-size:clamp(2.65rem,5.7vw,5.1rem);line-height:.97;letter-spacing:-.06em}.intro h1 em{color:var(--blue);font-style:normal}.intro>div>p{max-width:720px;margin-top:20px;color:var(--muted);font-size:.98rem}.decision-card{padding:22px;border:1px solid var(--line);border-radius:14px;background:rgba(23,36,58,.84)}.decision-card>span,.panel-heading span,.signal-copy>span,.action-brief>span{color:#8fbcf7;font-size:.65rem;font-weight:850;letter-spacing:.11em;text-transform:uppercase}.decision-card strong{display:block;margin-top:12px;font-size:1.1rem}.decision-card p{margin-top:8px;color:var(--muted);font-size:.78rem}
  .pattern-picker{display:flex;align-items:end;justify-content:space-between;gap:32px;padding:22px;border:1px solid var(--line);border-radius:16px;background:rgba(13,27,47,.86)}.pattern-picker h2{margin-top:5px;font-size:1.45rem}.pattern-buttons{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;min-width:min(100%,680px)}.pattern-buttons button{display:flex;align-items:center;gap:11px;padding:12px;border:1px solid var(--line);border-radius:10px;color:var(--muted);background:#111f34;text-align:left;cursor:pointer}.pattern-buttons button:hover,.pattern-buttons button:focus-visible{border-color:#557bac}.pattern-buttons button[aria-selected="true"]{border-color:#4f8ee3;color:var(--ink);background:#19375c}.pattern-buttons b{color:var(--blue);font-size:.7rem}.pattern-buttons span{font-size:.77rem;font-weight:800}.pattern-buttons small{display:block;margin-top:2px;color:var(--muted);font-size:.61rem;font-weight:600}
  .workspace{min-height:500px;margin-top:18px}.pattern-panel{padding:24px;border:1px solid var(--line);border-radius:18px;background:rgba(16,29,49,.92);box-shadow:0 24px 60px rgba(0,0,0,.2)}.pattern-panel[hidden]{display:none}.panel-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;padding-bottom:18px;border-bottom:1px solid var(--line)}.panel-heading h2{margin-top:3px;font-size:1.5rem}.panel-heading p{max-width:560px;color:var(--muted);font-size:.8rem}
  .local-tabs{display:flex;gap:3px;margin-top:18px;padding:4px;border-radius:10px;background:#0b1728}.local-tabs button{flex:1;padding:10px;border:0;border-radius:7px;color:var(--muted);background:transparent;font-size:.72rem;font-weight:800;cursor:pointer}.local-tabs button[aria-selected="true"]{color:#fff;background:#244b78}.signal-view{display:none}.signal-view.is-active{display:grid;grid-template-columns:1fr 1.05fr;gap:18px;padding-top:20px}.signal-copy{grid-row:span 2;padding:24px;border:1px solid var(--line);border-radius:13px;background:var(--panel)}.signal-copy h3{margin-top:10px;font-size:clamp(1.55rem,3vw,2.55rem);line-height:1;letter-spacing:-.04em}.signal-copy p{margin-top:14px;color:var(--muted);font-size:.86rem}.metric-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.metric-row>div{padding:15px;border:1px solid var(--line);border-radius:11px;background:var(--panel-2)}.metric-row span{display:block;color:var(--muted);font-size:.64rem}.metric-row strong{display:block;margin-top:7px;font-size:1.4rem}.metric-row small{display:inline-block;margin-top:6px;font-size:.59rem;font-weight:850;text-transform:uppercase}.metric-row small.healthy,.metric-row small.stable{color:var(--green)}.metric-row small.watch{color:var(--amber)}.metric-row small.act{color:#fb7185}.action-brief{display:grid;grid-template-columns:1fr auto;gap:4px 18px;align-items:center;padding:15px 18px;border-radius:11px;background:#0d1c30}.action-brief>span{grid-column:1}.action-brief p{color:#d5dfed;font-size:.76rem}.action-brief button{grid-column:2;grid-row:1/span 2;padding:9px 11px;border:1px solid #45648d;border-radius:8px;color:#bcd8ff;background:transparent;font-size:.68rem;font-weight:800}
  .disclosure-list{display:grid;gap:8px;margin-top:18px}.disclosure-list details{border:1px solid var(--line);border-radius:11px;background:var(--panel)}.disclosure-list summary{display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center;padding:13px 16px;cursor:pointer;list-style:none}.disclosure-list summary::-webkit-details-marker{display:none}.disclosure-list summary>span{color:var(--blue);font-size:.65rem;font-weight:850}.disclosure-list summary strong{display:block;font-size:.8rem}.disclosure-list summary small{display:block;margin-top:2px;color:var(--muted);font-size:.66rem}.disclosure-list summary i{color:var(--blue);font-size:1.1rem;font-style:normal}.disclosure-list details[open] summary i{transform:rotate(45deg)}.details-content{padding:0 14px 14px}.details-content .signal-view,.details-content>.signal-copy{display:grid}.details-content .signal-copy{grid-row:auto;padding:15px}.details-content .signal-copy h3{font-size:1.3rem}.details-content .signal-copy p{font-size:.76rem}.details-content .metric-row{margin-top:8px}.details-content .action-brief{margin-top:8px}
  .switcher-shell{display:grid;grid-template-columns:210px 1fr;gap:18px;margin-top:18px}.section-switcher{position:sticky;top:14px;display:grid;align-content:start;gap:5px;height:max-content;padding:7px;border-radius:12px;background:#0a1728}.section-switcher button{display:grid;grid-template-columns:25px 1fr;gap:7px;padding:11px;border:0;border-radius:8px;color:var(--muted);background:transparent;text-align:left;font-size:.72rem;font-weight:800;cursor:pointer}.section-switcher button span{color:#6683a8;font-size:.6rem}.section-switcher button.active{color:#fff;background:#23496f}.switcher-canvas{min-height:310px}.switcher-canvas .signal-view.is-active{padding-top:0}
  .review-footer{display:flex;justify-content:space-between;gap:24px;padding-block:20px 36px;color:var(--muted);font-size:.7rem}.review-footer>div{display:flex;gap:9px}.review-footer strong{color:#dce7f5}.sample-dot{flex:none;width:7px;height:7px;margin-top:5px;border-radius:50%;background:var(--green)}.review-footer a{color:var(--blue);font-weight:800}
  button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #93c5fd;outline-offset:3px}
  @media(max-width:900px){.intro{grid-template-columns:1fr;gap:24px}.pattern-picker{display:grid;align-items:start}.pattern-buttons{min-width:0}.signal-view.is-active{grid-template-columns:1fr}.signal-copy{grid-row:auto}.switcher-shell{grid-template-columns:1fr}.section-switcher{position:sticky;top:0;z-index:2;display:flex;overflow-x:auto}.section-switcher button{flex:0 0 auto}}
  @media(max-width:640px){.review-badge{display:none}.intro{padding-block:44px 28px}.intro h1{font-size:3rem}.pattern-buttons{grid-template-columns:1fr}.pattern-picker{padding:15px}.pattern-panel{padding:15px}.panel-heading{display:grid}.local-tabs{overflow-x:auto}.local-tabs button{flex:0 0 auto}.metric-row{grid-template-columns:1fr 1fr}.metric-row>div:last-child{grid-column:1/-1}.action-brief{grid-template-columns:1fr}.action-brief button{grid-column:1;grid-row:auto;width:max-content}.review-footer{display:grid}.brand strong{display:none}}
</style>
