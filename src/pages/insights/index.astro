---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("insights")).sort(
  (a, b) => a.data.articleNumber - b.data.articleNumber
);
---

<MainLayout
  title="Insights | Enterprise Agile"
  description="Enterprise delivery, cost governance, AI operations and executive reporting — seven frameworks from senior program leadership practice."
  canonicalPath="/insights/"
>
  <div class="insights-page">
    <Header />

    <main id="main-content">
      <section class="insights-hero model-container">
        <span class="eyebrow">INSIGHTS &amp; FRAMEWORKS</span>
        <h1>Evidence-based thinking on delivery, governance and responsible AI</h1>
        <p>Seven frameworks drawn from senior program leadership practice. Each article combines a real operating problem, the underlying governance gap, and a repeatable control you can apply next sprint.</p>
      </section>

      <section class="insights-grid model-container" aria-label="Article listing">
        {articles.map((article) => (
          <article class="insight-card">
            <div class="insight-meta">
              <span class="insight-category">{article.data.category}</span>
              <span class="insight-read">{article.data.readTime} read</span>
            </div>
            <h2><a href={`/insights/${article.slug}/`}>{article.data.title}</a></h2>
            <p>{article.data.excerpt}</p>
            <a class="insight-link" href={`/insights/${article.slug}/`}>
              Read article <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </section>

      <footer class="insights-footer model-container">
        <a href="/#articles">← Back to homepage</a>
      </footer>
    </main>
  </div>
</MainLayout>

<style>
  .insights-page {
    min-height: 100vh;
    background: radial-gradient(circle at 80% 10%, rgba(37,99,235,.16), transparent 30%),
      linear-gradient(180deg, #0f172a, #0b1220);
    color: #f1f5f9;
  }

  .insights-hero {
    padding-block: 72px 56px;
  }
  .insights-hero h1 {
    max-width: 780px;
    margin-top: 14px;
    font-size: clamp(2.4rem, 5.5vw, 4.6rem);
    line-height: .98;
    letter-spacing: -.055em;
    color: #f8fafc;
  }
  .insights-hero p {
    max-width: 680px;
    margin-top: 22px;
    color: #94a3b8;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .insights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: 20px;
    padding-bottom: 80px;
  }

  .insight-card {
    display: flex;
    flex-direction: column;
    padding: 32px;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 18px;
    background: rgba(255,255,255,.04);
    transition: border-color .2s, background .2s;
  }
  .insight-card:hover {
    border-color: rgba(96,165,250,.35);
    background: rgba(96,165,250,.06);
  }

  .insight-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .insight-category {
    padding: 3px 10px;
    border-radius: 99px;
    background: rgba(96,165,250,.15);
    color: #93c5fd;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .insight-read {
    color: #64748b;
    font-size: .72rem;
    font-weight: 700;
  }

  .insight-card h2 {
    margin-bottom: 12px;
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    line-height: 1.22;
    letter-spacing: -.025em;
  }
  .insight-card h2 a {
    color: #e2e8f0;
    text-decoration: none;
    transition: color .2s;
  }
  .insight-card h2 a:hover { color: #93c5fd; }

  .insight-card p {
    flex: 1;
    margin-bottom: 24px;
    color: #94a3b8;
    font-size: .9rem;
    line-height: 1.65;
  }

  .insight-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #60a5fa;
    font-size: .8rem;
    font-weight: 800;
    text-decoration: none;
    transition: gap .2s;
  }
  .insight-link:hover { gap: 12px; }

  .insights-footer {
    padding-bottom: 60px;
  }
  .insights-footer a {
    color: #64748b;
    font-size: .85rem;
    font-weight: 700;
    text-decoration: none;
    transition: color .2s;
  }
  .insights-footer a:hover { color: #93c5fd; }

  @media (max-width: 900px) {
    .insights-hero { padding-block: 52px 40px; }
    .insights-grid { padding-bottom: 56px; }
  }
</style>
