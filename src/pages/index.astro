</MainLayout>

<script>
  document.querySelectorAll('[data-framework-carousel]').forEach((carousel) => {
    const cards = Array.from(carousel.querySelectorAll('.framework-card'));
    const position = carousel.querySelector('[data-framework-position]');
    let current = 0;
    const show = (index) => {
      current = (index + cards.length) % cards.length;
      cards.forEach((card, cardIndex) => card.classList.toggle('is-current', cardIndex === current));
      if (position) position.textContent = String(current + 1);
    };
    carousel.querySelector('.carousel-prev')?.addEventListener('click', () => show(current - 1));
    carousel.querySelector('.carousel-next')?.addEventListener('click', () => show(current + 1));
  });
</script>
