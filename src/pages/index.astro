---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
---

<MainLayout title="Enterprise Agile">

<div id="top"></div>

<Header />

<Hero />

<section class="impact" id="impact" aria-labelledby="impact-title">

<div class="section-heading">
<span class="eyebrow">DELIVERY IMPACT</span>
<h2 id="impact-title">Enterprise delivery at a glance</h2>
<p>Experience, leadership and operating expertise focused on measurable transformation.</p>
</div>

<div class="metrics">

<div class="metric-card">
<h2>17+</h2>
<p>Years Experience</p>
</div>

<div class="metric-card">
<h2>Staff</h2>
<p>Program Manager</p>
</div>

<div class="metric-card">
<h2>CloudOps</h2>
<p>DevOps • AI</p>
</div>

<div class="metric-card">
<h2>Enterprise</h2>
<p>Transformation</p>
</div>

</div>

</section>

<section class="about" id="about" aria-labelledby="about-title">
  <div class="about-intro">
    <span class="eyebrow">WHAT I DELIVER</span>
    <h2 id="about-title">Strategy translated into operating results</h2>
    <p>
      I connect executive priorities, engineering execution and operational data
      to create delivery systems that leaders can trust and teams can sustain.
    </p>
  </div>

  <div class="capability-grid">
    <article class="capability-card">
      <span class="capability-number">01</span>
      <h3>Enterprise Program Leadership</h3>
      <p>Portfolio governance, dependency management and decision-ready reporting across complex programs.</p>
    </article>
    <article class="capability-card">
      <span class="capability-number">02</span>
      <h3>Cloud &amp; DevOps Operations</h3>
      <p>Reliable operating models spanning CloudOps, DevOps, SRE practices, releases and service performance.</p>
    </article>
    <article class="capability-card">
      <span class="capability-number">03</span>
      <h3>Agile Delivery Governance</h3>
      <p>Practical sprint controls, Jira governance and measurable flow improvements without process overhead.</p>
    </article>
    <article class="capability-card">
      <span class="capability-number">04</span>
      <h3>AI-Enabled Operations</h3>
      <p>Human-centered automation, intelligent reporting and agentic workflows built for adoption and auditability.</p>
    </article>
  </div>
</section>

<!-- release: 0.1.8 -->
</MainLayout>
