{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "enterprise-agile-site-prod",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "env": {
    "dev": {
      "name": "enterprise-agile-site-dev",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    },
    "staging": {
      "name": "enterprise-agile-site",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    },
    "production": {
      "name": "enterprise-agile-site-prod",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    }
  }
}
